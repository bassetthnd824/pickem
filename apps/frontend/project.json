{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project frontend --web",
  "targets": {
    "format": {
      "command": "oxfmt .",
      "options": {
        "cwd": "{projectRoot}"
      }
    },
    "format-check": {
      "command": "oxfmt --check .",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true
    }
  }
}
