# Copy to apps/frontend/.env.local (gitignored).
# The NEXT_PUBLIC values are the Firebase web config. They are not server
# secrets. The Auth emulator accepts a placeholder api key when projectId
# matches the emulator project and GOOGLE_CLOUD_PROJECT (pickem-local).

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pickem-local
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Server-only. The browser never receives this URL. Axios in Route Handlers
# forwards /api/* here. Unset uses http://localhost:8080. A blank value fails
# on the server. On Cloud Run (K_SERVICE), the proxy also sends a metadata
# identity token so Spring can require roles/run.invoker. Local runs do not.
SPRING_API_BASE_URL=http://localhost:8080

# Server-only. The request gate verifies `__session` with Firebase Admin
# (`verifySessionCookie`, revocation checked). The Admin SDK reads
# FIREBASE_AUTH_EMULATOR_HOST. When that is unset and this process is not
# on Cloud Run (K_SERVICE), a local NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST
# is used so the gate talks to the same emulator as the browser. On Cloud
# Run the public host is ignored. Unset both emulator hosts in GCP. Cloud
# Run uses application default credentials. Do not put a service account
# file, private key, or GOOGLE_APPLICATION_CREDENTIALS value in a
# NEXT_PUBLIC_ variable or in this file.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
GOOGLE_CLOUD_PROJECT=pickem-local

# Server-only. Admits POST /api/internal/jobs/* when the header
# X-Pickem-Job-Secret matches. Cloud Scheduler can instead send
# Authorization: Bearer. OIDC stays off until both of the variables below
# are set: the token aud must equal PICKEM_INTERNAL_JOB_AUDIENCE (the
# public job URL, no query string; not the request Host), and the token
# email must be one of PICKEM_INTERNAL_JOB_OIDC_EMAILS (comma-separated).
# The __session cookie is not a credential. Use the same secret value in
# apps/backend/.env. Leave the secret blank only if you do not call
# internal jobs through Next.js. Do not put these in NEXT_PUBLIC_ variables.
PICKEM_INTERNAL_JOB_SECRET=
PICKEM_INTERNAL_JOB_AUDIENCE=
PICKEM_INTERNAL_JOB_OIDC_EMAILS=
