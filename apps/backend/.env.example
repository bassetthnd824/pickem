# Copy to apps/backend/.env (gitignored) for local development.
# OS environment variables override these values.
# In GCP, set PICKEM_SECRET_MANAGER_ENABLED=true to resolve sm:// secrets,
# or mount the same names from Secret Manager as Cloud Run env vars.

PICKEM_SECRET_MANAGER_ENABLED=false
GOOGLE_CLOUD_PROJECT=pickem-local

# Local Firestore emulator (firebase.json uses port 8085 so it does not
# collide with Spring on 8080). The Java client also honors
# FIRESTORE_EMULATOR_HOST when that env var is set.
FIRESTORE_EMULATOR_ENABLED=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

CFBD_API_KEY=
