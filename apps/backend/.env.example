# Copy to apps/backend/.env (gitignored) for local development.
# OS environment variables override these values.
# In GCP, set PICKEM_SECRET_MANAGER_ENABLED=true to resolve sm:// secrets,
# or mount the same names from Secret Manager as Cloud Run env vars.

PICKEM_SECRET_MANAGER_ENABLED=false
# GOOGLE_CLOUD_PROJECT=your-gcp-project

CFBD_API_KEY=
