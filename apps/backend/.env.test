# Environment for `npx nx run backend:test`.
# A blank value removes that variable. dotenvx --overload cannot do that:
# `CFBD_API_KEY=` is still set, and a set value hides the fixture files used
# by the dotenv and seed tests. Backend tests also start their own Firestore
# emulator, so a developer FIRESTORE_EMULATOR_HOST must not be kept.

PICKEM_SECRET_MANAGER_ENABLED=false
PICKEM_INTERNAL_ALLOW_LOOPBACK=true

GOOGLE_CLOUD_PROJECT=
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
CFBD_API_KEY=
PICKEM_BOOTSTRAP_MANAGER_EMAIL=
PICKEM_DOTENV_FILE=
PICKEM_INTERNAL_JOB_SECRET=
