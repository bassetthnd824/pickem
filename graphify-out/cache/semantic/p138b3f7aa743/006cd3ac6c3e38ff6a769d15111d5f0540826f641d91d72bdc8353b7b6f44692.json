{"nodes": [{"id": "docs_open_decisions_open_decisions", "label": "Open Decisions", "file_type": "document", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source of truth for assumed defaults and decided behaviors shared by backend, frontend, seed, and CFBD work. Do not reopen without updating this file."}, {"id": "docs_open_decisions_google_sign_in_open", "label": "Open Google Sign-in", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any Google account may sign in. First sign-in auto-assigns the player claim and creates a users document. Not a domain allowlist."}, {"id": "docs_open_decisions_default_theme_light", "label": "Default Theme Light", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Default themeId is light. prefers-color-scheme may later switch the Light/Dark pair on first visit but is not the default."}, {"id": "docs_open_decisions_cfbd_conference_sec", "label": "CFBD conference=SEC Scope", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GET games with conference=SEC returns every game with an SEC team on either side, including non-conference opponents, not SEC-vs-SEC only."}, {"id": "docs_open_decisions_scores_when_completed", "label": "Scores Only When Completed", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scores are written only when CFBD marks the game completed with both homePoints and awayPoints. No live in-progress scoring."}, {"id": "docs_open_decisions_pick_lock", "label": "Pick Lock at Week Begin", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Once a week's beginDate is today or past, that week's picks cannot be saved. Results show for current and past weeks only."}, {"id": "docs_open_decisions_ties_invalid", "label": "Ties Invalid", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Equal home and away scores are HTTP 400. winningTeamId requires a strict winner. College football ties are invalid."}, {"id": "docs_open_decisions_closed_theme_set", "label": "Closed Set of 18 Themes", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eighteen compiled palettes: Light, Dark, and 16 SEC schools. Admin may activate, deactivate, and rename only."}, {"id": "docs_open_decisions_snapshot_refresh", "label": "Denormalized Snapshot Refresh", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saving a team or venue refreshes denormalized fields on matchups, rivalries, and teams."}, {"id": "docs_open_decisions_blocked_deletes", "label": "Blocked Deletes", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deletes return 409 while children or references exist. No cascade of picks."}, {"id": "docs_open_decisions_public_origin", "label": "Next.js Only Public Origin", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Next.js is the only public origin. Spring is internal. An Application Load Balancer is not required."}, {"id": "docs_open_decisions_session_cookie", "label": "HttpOnly Session Cookie", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auth uses an HttpOnly __session cookie minted by Firebase Admin createSessionCookie, not a per-request Bearer token."}, {"id": "docs_open_decisions_base_ui", "label": "Base UI Controls", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interactive controls use @base-ui/react. Links compose via the render prop. Tables, headings, and plain text stay semantic HTML."}, {"id": "docs_open_decisions_background_import", "label": "Background CFBD Import", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Import is a background job plus UI poll (202 plus job id), not one synchronous BFF POST. Regular season is default; postseason is optional."}, {"id": "docs_open_decisions_eastern_timezone", "label": "America/New_York Game Day", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Game-day timezone is America/New_York. Manual week CRUD is Thursday-Wednesday; CFBD weeks come from GET /calendar."}, {"id": "docs_open_decisions_server_only_api_key", "label": "Server-only CFBD API Key", "file_type": "rationale", "source_file": "docs/open-decisions.md", "source_location": null, "source_url"