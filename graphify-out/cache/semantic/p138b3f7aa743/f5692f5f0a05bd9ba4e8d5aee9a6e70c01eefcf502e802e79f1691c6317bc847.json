{"nodes": [{"id": "docs_modernization_plan_modernization_plan", "label": "Modernization Plan", "file_type": "document", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Greenfield rewrite of the Struts 2 / EJB / Derby WAR into Next.js, Spring Boot, and Firestore that preserves behavior. The existing Java/JSP tree is the functional spec."}, {"id": "docs_modernization_plan_confidence_pickem", "label": "Confidence Pick'em", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each week a player picks a winner for every matchup and assigns rank 1..N. A correct pick earns its rank. Managers CRUD reference and schedule data."}, {"id": "docs_modernization_plan_greenfield_rewrite", "label": "Greenfield Behavior-Preserving Rewrite", "file_type": "rationale", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not an in-place refactor. Nothing in src/main is modified. Legacy tree stays until parity is verified, then is removed."}, {"id": "docs_modernization_plan_nx_monorepo", "label": "Nx Monorepo Layout", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "apps/frontend via @nx/next, apps/backend Maven via @jnxplus/nx-maven, optional libs/shared-schemas, tools/seed. skipProjectWithoutProjectJson keeps the legacy POM out of the graph."}, {"id": "docs_modernization_plan_base_repository", "label": "BaseRepository", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared Firestore repository replacing GenericHibernateBean and BaseAction audit. findById, findAll, query, save, delete plus audit and version stamping in a transaction."}, {"id": "docs_modernization_plan_session_cookie_filter", "label": "SessionCookieFilter", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads the forwarded __session cookie and verifies it with Firebase Admin verifySessionCookie checkRevoked true. Roles come from custom claims. Replaces web.xml constraints and LoginFilter."}, {"id": "docs_modernization_plan_matchup_service", "label": "MatchupService", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces MatchupBean. Loads season matchups and user picks and joins them in code. No SQL."}, {"id": "docs_modernization_plan_pick_service", "label": "PickService", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces MainAction.save and UserPickBean.persistList. Bulk upsert of weekly picks; drops empty picks."}, {"id": "docs_modernization_plan_leaderboard_service", "label": "LeaderboardService", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scoring engine replacing LeaderBoardAction. Sums rank where pickedTeamId equals winningTeamId, sorts descending, tie-breaks by userId."}, {"id": "docs_modernization_plan_auth_flow", "label": "Firebase Auth Flow", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google ID token is posted once to Next.js /api/auth/session. Spring provisions users, sets player if new, and mints a session cookie. Middleware verifies the cookie with Firebase Admin."}, {"id": "docs_modernization_plan_cloud_run", "label": "Cloud Run Split Hosting", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public Next.js Cloud Run is the only origin. Spring ingress is internal, unauthenticated invocation denied, invoker is the Next.js service account. No ALB and no CORS."}, {"id": "docs_modernization_plan_validation_parity", "label": "Valibot and Spring Validation Parity", "file_type": "concept", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every JSR-303 rule is reproduced in Valibot and Spring. Password constraints are dropped because Google owns the credential."}, {"id": "docs_modernization_plan_no_registration", "label": "Registration Dropped", "file_type": "rationale", "source_file": "docs/modernization-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No RegistrationService and no email/password. Google sign-in provisions users. Account no longer has old/new/confirm password."}], "edges": [{"source": "docs_modernization_plan_modernization_plan", "target": "docs_firestore_data_model_data_model", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modernization-plan.md", "source_location": null, "weight": 1.0}, {"source": "docs_modernization_plan_modernization_plan", "target": "docs_api_contract_api_contract", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/modernization-plan.md", "source_location": null, "weight