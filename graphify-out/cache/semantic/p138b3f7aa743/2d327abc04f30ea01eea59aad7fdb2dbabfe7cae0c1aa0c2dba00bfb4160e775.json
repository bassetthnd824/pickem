{"nodes": [{"id": "docs_firestore_data_model_data_model", "label": "Firestore Data Model", "file_type": "document", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source of truth for the nine domain collections. Seed work and backend DTOs must follow it. Native mode; Spring Admin SDK is the only writer."}, {"id": "docs_firestore_data_model_audit_fields", "label": "Document Audit and Version", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Domain documents carry createDate, createUser, lastUpdateDate, lastUpdateUser, and version. version is an optimistic lock checked in a transaction by BaseRepository. createDate is never overwritten."}, {"id": "docs_firestore_data_model_seasons", "label": "seasons", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces PCKM_SEASON. season year, beginDate, endDate, isCurrent. isCurrent replaces the Derby getCurrentSeason query."}, {"id": "docs_firestore_data_model_season_weeks", "label": "seasonWeeks", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces PCKM_SEASON_WEEK. Manual CRUD is Thursday begin and Wednesday end. CFBD import upserts weeks from GET /calendar and is not subject to that rule."}, {"id": "docs_firestore_data_model_venues", "label": "venues", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces PCKM_VENUE. Optional unique cfbdVenueId. A seeded Unknown venue is used when import cannot resolve a home venue."}, {"id": "docs_firestore_data_model_teams", "label": "teams", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces PCKM_TEAM. Embeds homeVenue snapshot and keeps homeVenueId. The 16 SEC schools are conferenceMember true and must have cfbdTeamId before import."}, {"id": "docs_firestore_data_model_rivalries", "label": "rivalries", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces PCKM_RIVALRY. Embeds both team snapshots. team1.id must differ from team2.id."}, {"id": "docs_firestore_data_model_matchups", "label": "matchups", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces PCKM_MATCHUP and the denormalized Test.sql join. Read-heavy picks grid document. winningTeamId is server-computed. Optional unique cfbdGameId is the idempotent upsert key."}, {"id": "docs_firestore_data_model_picks", "label": "picks", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces PCKM_USER_PICK. One document per user per matchup. Rank is 1..N where N is conference team count and unique per user per week. A correct pick earns its rank."}, {"id": "docs_firestore_data_model_users", "label": "users", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces PCKM_USER. Document id is the Firebase uid. No password. roles mirrors custom claims. nickName and themeId stay user-owned across sign-in."}, {"id": "docs_firestore_data_model_themes", "label": "themes", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces PCKM_THEME. Closed catalog of 18 palettes. Hex and keys come from sec-theme-colors.md. Inactive themes are hidden from the account picker."}, {"id": "docs_firestore_data_model_denormalized_snapshots", "label": "Denormalized Snapshots", "file_type": "rationale", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Firestore has no joins. Read-heavy documents embed team, venue, week, and rivalry display fields. Id fields stay so edits and deletes can find references."}, {"id": "docs_firestore_data_model_dropped_derby", "label": "Dropped Derby Identity Tables", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PCKM_GROUP, passwords and SHA-256, sequences, JPA metamodel, and SQL joins are dropped. No historical Derby data is migrated."}, {"id": "docs_firestore_data_model_import_jobs", "label": "importJobs", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Operational CFBD import job status. Not one of the nine domain collections and not client-readable."}, {"id": "docs_firestore_data_model_composite_indexes", "label": "Firestore Composite Indexes", "file_type": "concept", "source_file": "docs/firestore-data-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indexes in firestore.indexes.json for picks, matchups, seasonWeeks, and CFBD id lookups. Applied to the emulator and GCP in US-39."}], "edges": [{"source": "docs_firestore_data_model_data_model", "target": "docs_modernization_plan_modernization_plan", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/firestore-data-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_firestore_data_model_data_model", "target": "docs_api_contract_api_contract", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/firestore-data-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_firestore_data_model_themes", "target": "docs_sec_theme_colors_theme_colors", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/firestore-data-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_firestore_data_model_composite_indexes", "target": "docs_user_stories_us_39", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/firestore-data-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_firestore_data_model_teams", "target": "docs_firestore_data_model_venues", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/firestore-data-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_firestore_data_model_rivalries", "target": "docs_firestore_data_model_teams", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/firestore-data-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_firestore_data_model_matchups", "target": "docs_firestore_data_model_teams", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/firestore-data-model.md", "source_location": null, "weight": 1.0}, {"source": "docs_firestore_data_model_matchups", "