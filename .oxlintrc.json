{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "nextjs",
    "import",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "src/**",
    "**/dist/**",
    "**/.next/**",
    "**/out-tsc/**",
    "**/target/**",
    "**/coverage/**",
    "**/.nx/**",
    "**/next-env.d.ts",
    "**/vitest.config.*.timestamp*"
  ],
  "jsPlugins": [
    "@nx/oxlint/boundaries-plugin",
    "@stylistic/eslint-plugin",
    "eslint-plugin-perfectionist"
  ],
  "settings": {
    "next": {
      "rootDir": "apps/frontend/"
    },
    "react": {
      "version": "19.0",
      "linkComponents": [{ "name": "Link", "linkAttribute": "href" }]
    },
    "jsx-a11y": {
      "components": {
        "Link": "a"
      }
    }
  },
  "rules": {
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "enforceBuildableLibDependency": true,
        "allow": ["^.*/eslint(\\.base)?\\.config\\.[cm]?[jt]s$", "^.*/oxlint\\.config\\.[cm]?ts$"],
        "depConstraints": [
          {
            "sourceTag": "*",
            "onlyDependOnLibsWithTags": ["*"]
          }
        ]
      }
    ],
    "react/rules-of-hooks": "error",
    "react/display-name": "warn",
    "react/jsx-no-comment-textnodes": "warn",
    "react/style-prop-object": "warn",
    "react/react-in-jsx-scope": "off",
    "import/no-duplicates": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "warn",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unsafe-function-type": "error",
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "ignoreRestSiblings": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/frontend/**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"],
      "rules": {
        "@stylistic/quotes": [
          "error",
          "single",
          {
            "avoidEscape": true,
            "allowTemplateLiterals": true
          }
        ],
        "@stylistic/jsx-quotes": ["error", "prefer-single"],
        "@stylistic/semi": ["error", "never"],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["./*", "../*", "./**", "../**"],
                "message": "Import from @/ instead of a relative path."
              }
            ]
          }
        ],
        "perfectionist/sort-imports": [
          "error",
          {
            "type": "alphabetical",
            "order": "asc",
            "ignoreCase": true,
            "sortSideEffects": true,
            "internalPattern": ["^@/.+"],
            "newlinesBetween": 0,
            "groups": [
              [
                "type-builtin",
                "type-external",
                "value-builtin",
                "value-external",
                "side-effect",
                "type-side-effect",
                "value-side-effect"
              ],
              {
                "newlinesBetween": 1
              },
              [
                "type-internal",
                "value-internal",
                "type-parent",
                "value-parent",
                "type-sibling",
                "value-sibling",
                "type-index",
                "value-index",
                "type-subpath",
                "value-subpath",
                "type-style",
                "value-style",
                "side-effect-style",
                "type-side-effect-style",
                "value-side-effect-style"
              ],
              "unknown"
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.{spec,test}.{ts,tsx,js,jsx}"],
      "rules": {
        "vitest/no-disabled-tests": "warn",
        "vitest/no-focused-tests": "error"
      }
    }
  ]
}
